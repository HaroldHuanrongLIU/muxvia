{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxvia.dev/protocol/control-v1.schema.json",
  "title": "Muxvia control protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/clientFrame" },
    { "$ref": "#/$defs/serverFrame" },
    { "$ref": "#/$defs/targetView" },
    { "$ref": "#/$defs/targetAction" },
    { "$ref": "#/$defs/universalProviderCatalog" },
    { "$ref": "#/$defs/universalProviderAction" }
  ],
  "$defs": {
    "rpc": {
      "type": "object",
      "properties": { "major": { "const": 1 }, "minor": { "const": 0 } },
      "required": ["major", "minor"]
    },
    "claudeBlockingSelector": {
      "enum": ["CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "CLAUDE_CODE_USE_MANTLE", "CLAUDE_CODE_USE_ANTHROPIC_AWS", "CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST"]
    },
    "reconciliationStrategy": { "enum": ["adopt", "reapply", "restore"] },
    "compatibilityClassification": { "enum": ["tested", "unknown-compatible", "incompatible"] },
    "compatibilityView": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string" },
        "classification": { "$ref": "#/$defs/compatibilityClassification" },
        "acknowledgementRequired": { "type": "boolean" }
      },
      "required": ["version", "classification", "acknowledgementRequired"]
    },
    "compatibilityProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["codex", "claude"] },
        "managementRevision": { "type": "integer", "minimum": 0 },
        "compatibility": { "$ref": "#/$defs/compatibilityView" }
      },
      "required": ["target", "managementRevision", "compatibility"]
    },
    "reconciliationFieldState": { "enum": ["present", "absent", "unchanged", "changed"] },
    "reconciliationField": { "enum": ["provider", "credential", "current-provider", "activated-snapshot", "takeover"] },
    "shadowSource": {
      "oneOf": [
        { "enum": ["codex-profile", "claude-managed", "claude-shared", "claude-project", "claude-local", "claude-host-managed"] },
        { "type": "object", "properties": { "claude-selector": { "$ref": "#/$defs/claudeBlockingSelector" } }, "required": ["claude-selector"], "additionalProperties": false }
      ]
    },
    "reconciliationPreview": {
      "type": "object",
      "properties": {
        "observationToken": { "type": "string", "format": "uuid" },
        "target": { "enum": ["codex", "claude"] },
        "strategy": { "$ref": "#/$defs/reconciliationStrategy" },
        "managementRevision": { "type": "integer", "minimum": 1 },
        "compatibility": { "$ref": "#/$defs/compatibilityView" },
        "shadowSources": { "type": "array", "items": { "$ref": "#/$defs/shadowSource" } },
        "changes": { "type": "array", "items": { "type": "object", "properties": { "field": { "$ref": "#/$defs/reconciliationField" }, "state": { "$ref": "#/$defs/reconciliationFieldState" } }, "required": ["field", "state"] } },
        "providerEffect": { "enum": ["create-new", "keep-current", "exit-managed"] },
        "restartRequired": { "type": "boolean" },
        "unobservableRuntimeBoundary": { "type": "boolean" }
      },
      "required": ["observationToken", "target", "strategy", "managementRevision", "compatibility", "shadowSources", "changes", "providerEffect", "restartRequired", "unobservableRuntimeBoundary"]
    },
    "clientFrame": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "hello" }, "rpc": { "$ref": "#/$defs/rpc" }, "release": { "type": "string" } }, "required": ["type", "rpc", "release"] },
        { "type": "object", "properties": { "type": { "const": "request" }, "requestId": { "type": "string" }, "operation": { "$ref": "#/$defs/controlOperation" } }, "required": ["type", "requestId", "operation"] },
        { "type": "object", "properties": { "type": { "const": "cancel" }, "requestId": { "type": "string" } }, "required": ["type", "requestId"] }
      ]
    },
    "serverFrame": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "hello-ack" }, "rpc": { "$ref": "#/$defs/rpc" }, "release": { "type": "string" }, "serviceEpoch": { "type": "string", "format": "uuid" }, "frameLimit": { "const": 1048576 } }, "required": ["type", "rpc", "release", "serviceEpoch", "frameLimit"] },
        { "type": "object", "properties": { "type": { "const": "response" }, "requestId": { "type": "string" }, "result": { "$ref": "#/$defs/controlResult" } }, "required": ["type", "requestId", "result"] },
        { "type": "object", "properties": { "type": { "const": "error" }, "requestId": { "type": ["string", "null"] }, "problem": { "$ref": "#/$defs/controlProblem" }, "authoritativeView": { "$ref": "#/$defs/targetView" } }, "required": ["type", "requestId", "problem"] },
        { "type": "object", "properties": { "type": { "const": "target-view" }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["type", "view"] },
        { "type": "object", "additionalProperties": false, "properties": { "type": { "const": "universal-provider-view" }, "view": { "$ref": "#/$defs/universalProviderCatalog" } }, "required": ["type", "view"] }
      ]
    },
    "controlOperation": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "open-universal-providers" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "universal-provider-act" }, "actionId": { "type": "string", "format": "uuid" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "action": {} }, "required": ["kind", "actionId", "expectedRevision", "action"] },
        { "type": "object", "properties": { "kind": { "const": "open-target" }, "target": { "enum": ["codex", "claude"] }, "claudeContext": { "$ref": "#/$defs/claudePreflightContext" } }, "required": ["kind", "target"] },
        { "type": "object", "properties": { "kind": { "const": "act" }, "target": { "enum": ["codex", "claude"] }, "actionId": { "type": "string", "format": "uuid" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "action": {} }, "required": ["kind", "target", "actionId", "expectedRevision", "action"] },
        { "type": "object", "properties": { "kind": { "const": "discover-models" }, "target": { "enum": ["codex", "claude"] }, "source": { "$ref": "#/$defs/discoverySource" } }, "required": ["kind", "target", "source"] },
        { "type": "object", "properties": { "kind": { "const": "check-reachability" }, "target": { "enum": ["codex", "claude"] }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "target", "providerId", "providerRevision"] },
        { "type": "object", "properties": { "kind": { "const": "preview-reconciliation" }, "target": { "enum": ["codex", "claude"] }, "strategy": { "$ref": "#/$defs/reconciliationStrategy" }, "claudeContext": { "$ref": "#/$defs/claudePreflightContext" } }, "required": ["kind", "target", "strategy"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "probe-compatibility" }, "target": { "enum": ["codex", "claude"] } }, "required": ["kind", "target"] }
      ]
    },
    "discoverySource": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "saved" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] },
        { "type": "object", "properties": { "kind": { "const": "draft" }, "baseUrl": { "type": "string" }, "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] }, "credentialSource": { "$ref": "#/$defs/draftCredentialSource" } }, "required": ["kind", "baseUrl", "authentication", "credentialSource"] }
      ]
    },
    "claudePreflightContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "claudeConfigDir": { "type": ["string", "null"] },
        "selectorState": { "enum": ["unset", "disabled", "enabled", "unknown-nonempty"] },
        "blockingSelector": { "oneOf": [{ "$ref": "#/$defs/claudeBlockingSelector" }, { "type": "null" }] },
        "hostManagedState": { "enum": ["unmanaged", "managed", "unknown"] },
        "cwd": { "type": "string" }
      },
      "required": ["claudeConfigDir", "selectorState", "hostManagedState", "cwd"],
      "allOf": [
        {
          "if": { "properties": { "selectorState": { "enum": ["enabled", "unknown-nonempty"] } }, "required": ["selectorState"] },
          "then": {
            "properties": { "blockingSelector": { "enum": ["CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY", "CLAUDE_CODE_USE_MANTLE", "CLAUDE_CODE_USE_ANTHROPIC_AWS"] } },
            "required": ["blockingSelector"]
          }
        },
        {
          "if": {
            "properties": {
              "selectorState": { "enum": ["unset", "disabled"] },
              "hostManagedState": { "enum": ["managed", "unknown"] }
            },
            "required": ["selectorState", "hostManagedState"]
          },
          "then": {
            "properties": { "blockingSelector": { "const": "CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST" } },
            "required": ["blockingSelector"]
          }
        },
        {
          "if": {
            "properties": {
              "selectorState": { "enum": ["unset", "disabled"] },
              "hostManagedState": { "const": "unmanaged" }
            },
            "required": ["selectorState", "hostManagedState"]
          },
          "then": { "properties": { "blockingSelector": { "type": "null" } } }
        }
      ]
    },
    "draftCredentialSource": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "missing" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "ephemeral" }, "value": { "type": "string" } }, "required": ["kind", "value"] },
        { "type": "object", "properties": { "kind": { "const": "saved" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] }
      ]
    },
    "controlResult": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "target-view" }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["kind", "view"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "universal-provider-catalog" }, "view": { "$ref": "#/$defs/universalProviderCatalog" } }, "required": ["kind", "view"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "universal-provider-outcome" }, "outcome": { "type": "object", "additionalProperties": false, "properties": { "status": { "enum": ["applied", "replayed"] }, "view": { "$ref": "#/$defs/universalProviderCatalog" } }, "required": ["status", "view"] } }, "required": ["kind", "outcome"] },
        { "type": "object", "properties": { "kind": { "const": "action-outcome" }, "outcome": { "type": "object", "properties": { "status": { "enum": ["applied", "replayed"] }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["status", "view"] } }, "required": ["kind", "outcome"] },
        { "type": "object", "properties": { "kind": { "const": "model-discovery" }, "result": { "$ref": "#/$defs/modelDiscoveryResult" } }, "required": ["kind", "result"] },
        { "type": "object", "properties": { "kind": { "const": "reachability" }, "result": { "$ref": "#/$defs/reachabilityResult" } }, "required": ["kind", "result"] },
        { "type": "object", "properties": { "kind": { "const": "reconciliation-preview" }, "preview": { "$ref": "#/$defs/reconciliationPreview" } }, "required": ["kind", "preview"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "compatibility-probe" }, "probe": { "$ref": "#/$defs/compatibilityProbe" } }, "required": ["kind", "probe"] }
      ]
    },
    "inspectionCategory": {
      "enum": ["invalid-endpoint", "missing-credential", "missing-provider", "stale-provider-revision", "authentication-rejected", "endpoint-unsupported", "rate-limited", "upstream-status", "timeout", "dns", "connect", "tls", "cancelled", "malformed-response", "response-too-large", "too-many-models"]
    },
    "inspectionFailure": {
      "type": "object",
      "properties": { "category": { "$ref": "#/$defs/inspectionCategory" }, "httpStatus": { "type": ["integer", "null"] }, "attempts": { "type": "integer", "minimum": 0 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "endpointOrigin": { "type": ["string", "null"] } },
      "required": ["category", "httpStatus", "attempts", "elapsedMs", "endpointOrigin"]
    },
    "modelDiscoveryResult": {
      "oneOf": [
        { "type": "object", "properties": { "status": { "const": "success" }, "models": { "type": "array", "maxItems": 2048, "items": { "type": "object", "properties": { "id": { "type": "string" }, "displayName": { "type": ["string", "null"] } }, "required": ["id", "displayName"] } }, "attempts": { "type": "integer", "minimum": 1 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "endpointOrigin": { "type": "string" } }, "required": ["status", "models", "attempts", "elapsedMs", "endpointOrigin"] },
        { "type": "object", "properties": { "status": { "const": "failure" }, "failure": { "$ref": "#/$defs/inspectionFailure" } }, "required": ["status", "failure"] }
      ]
    },
    "reachabilityResult": {
      "oneOf": [
        { "type": "object", "properties": { "status": { "const": "reachable" }, "httpStatus": { "type": "integer", "minimum": 100, "maximum": 999 }, "ttfbMs": { "type": "integer", "minimum": 0 }, "checkedAtUnixMs": { "type": "integer", "minimum": 0 }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 }, "slow": { "type": "boolean" }, "endpointOrigin": { "type": "string" } }, "required": ["status", "httpStatus", "ttfbMs", "checkedAtUnixMs", "retryCount", "slow", "endpointOrigin"] },
        { "type": "object", "properties": { "status": { "const": "unreachable" }, "failure": { "$ref": "#/$defs/inspectionFailure" }, "checkedAtUnixMs": { "type": "integer", "minimum": 0 }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 } }, "required": ["status", "failure", "checkedAtUnixMs", "retryCount"] }
      ]
    },
    "targetAction": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "create-provider" }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" }, "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] }, "presetKey": { "oneOf": [{ "const": "openai-api-responses" }, { "const": "anthropic-api-messages" }, { "type": "null" }] } }, "required": ["kind", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "update-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" }, "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] } }, "required": ["kind", "providerId", "providerRevision", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "reorder-providers" }, "providerIds": { "type": "array", "items": { "type": "string", "format": "uuid" } } }, "required": ["kind", "providerIds"] },
        { "type": "object", "properties": { "kind": { "const": "delete-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] },
        { "type": "object", "properties": { "kind": { "const": "duplicate-provider" }, "sourceProviderId": { "type": "string", "format": "uuid" }, "sourceProviderRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/duplicateCredential" } }, "required": ["kind", "sourceProviderId", "sourceProviderRevision", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "activate-provider" }, "providerId": { "type": "string" }, "mode": { "enum": ["direct", "takeover"] } }, "required": ["kind", "providerId", "mode"] },
        { "type": "object", "properties": { "kind": { "const": "reconcile" }, "strategy": { "$ref": "#/$defs/reconciliationStrategy" }, "observationToken": { "type": "string", "format": "uuid" }, "acknowledgeVersion": { "type": "string" } }, "required": ["kind", "strategy", "observationToken"] },
        { "type": "object", "additionalProperties": false, "properties": { "kind": { "const": "resolve-compatibility" }, "version": { "type": "string" } }, "required": ["kind", "version"] }
      ]
    },
    "universalProviderPresetTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["codex", "claude"] },
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] },
        "routingRequirement": { "enum": ["direct-compatible", "takeover-required"] }
      },
      "required": ["target", "enabled", "model", "authentication", "routingRequirement"]
    },
    "universalProviderPreset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": { "enum": ["openai-api-responses", "anthropic-api-messages"] },
        "name": { "type": "string" },
        "baseUrl": { "type": "string" },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderPresetTarget" } }
      },
      "required": ["key", "name", "baseUrl", "targets"]
    },
    "universalProviderTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["codex", "claude"] },
        "enabled": { "type": "boolean" },
        "model": { "type": "string" },
        "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] },
        "routingRequirement": { "enum": ["direct-compatible", "takeover-required"] },
        "overlayRevision": { "type": "integer", "minimum": 1 },
        "generatedProviderId": { "type": ["string", "null"], "format": "uuid" },
        "synchronization": { "enum": ["current", "pending"] },
        "activeReferences": { "type": "array", "items": { "enum": ["current", "activated-snapshot", "activated-route-plan"] } }
      },
      "required": ["target", "enabled", "model", "authentication", "routingRequirement", "overlayRevision", "generatedProviderId", "synchronization", "activeReferences"]
    },
    "universalProvider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "position": { "type": "integer", "minimum": 0 },
        "providerRevision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "baseUrl": { "type": "string" },
        "credential": { "enum": ["present", "missing"] },
        "provenance": { "type": ["object", "null"], "properties": { "kind": { "type": "string" }, "key": { "type": "string" } }, "required": ["kind", "key"] },
        "targets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderTarget" } }
      },
      "required": ["id", "position", "providerRevision", "name", "baseUrl", "credential", "provenance", "targets"]
    },
    "universalProviderCatalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": { "type": "integer", "minimum": 0 },
        "viewSequence": { "type": "integer", "minimum": 0 },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/universalProvider" } },
        "presets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderPreset" } }
      },
      "required": ["revision", "viewSequence", "providers", "presets"]
    },
    "universalProviderAction": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "create-universal-provider" }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" }, "presetKey": { "oneOf": [{ "enum": ["openai-api-responses", "anthropic-api-messages"] }, { "type": "null" }] }, "targets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderPresetTarget" } } }, "required": ["kind", "name", "baseUrl", "credential", "presetKey", "targets"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "update-universal-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" }, "targets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderPresetTarget" } } }, "required": ["kind", "providerId", "providerRevision", "name", "baseUrl", "credential", "targets"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "duplicate-universal-provider" }, "sourceProviderId": { "type": "string", "format": "uuid" }, "sourceProviderRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "credential": { "$ref": "#/$defs/duplicateCredential" }, "targets": { "type": "array", "items": { "$ref": "#/$defs/universalProviderPresetTarget" } } }, "required": ["kind", "sourceProviderId", "sourceProviderRevision", "name", "baseUrl", "credential", "targets"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "delete-universal-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"], "additionalProperties": false },
        { "type": "object", "properties": { "kind": { "const": "synchronize-universal-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"], "additionalProperties": false }
      ]
    },
    "targetView": {
      "type": "object",
      "properties": {
        "target": { "enum": ["codex", "claude"] },
        "managementRevision": { "type": "integer", "minimum": 0 },
        "viewSequence": { "type": "integer", "minimum": 0 },
        "service": { "type": "object", "properties": { "epoch": { "type": "string", "format": "uuid" }, "state": { "type": "string" } }, "required": ["epoch", "state"] },
        "mode": { "type": "string" },
        "takeover": { "type": "object" },
        "routeHealth": { "type": "object", "properties": { "state": { "const": "unobserved" } }, "required": ["state"], "additionalProperties": false },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
        "providerPresets": { "type": "array", "items": { "$ref": "#/$defs/providerPreset" } },
        "currentProviderId": { "type": ["string", "null"] },
        "servingProviderId": { "type": ["string", "null"] },
        "managedConfiguration": { "type": "object" },
        "recovery": { "type": "object", "properties": { "intentId": { "type": ["string", "null"], "format": "uuid" }, "state": { "type": "string" } }, "required": ["intentId", "state"], "additionalProperties": false },
        "activatedSnapshot": { "oneOf": [{ "$ref": "#/$defs/activatedSnapshot" }, { "type": "null" }] },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/controlProblem" } }
      },
      "required": ["target", "managementRevision", "viewSequence", "service", "mode", "takeover", "routeHealth", "providers", "providerPresets", "currentProviderId", "servingProviderId", "managedConfiguration", "recovery", "activatedSnapshot", "problems"]
    },
    "credentialEdit": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "keep" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "remove" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "replace" }, "value": { "type": "string" } }, "required": ["kind", "value"] }
      ]
    },
    "duplicateCredential": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "without" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "reuse-source" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "replace" }, "value": { "type": "string" } }, "required": ["kind", "value"] }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "position": { "type": "integer", "minimum": 0 },
        "providerRevision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "baseUrl": { "type": "string" },
        "model": { "type": "string" },
        "protocol": { "enum": ["openai-responses", "anthropic-messages"] },
        "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] },
        "routingRequirement": { "enum": ["direct-compatible", "takeover-required"] },
        "credential": { "enum": ["present", "missing"] },
        "completeness": { "enum": ["complete", "incomplete"] },
        "missingFields": { "type": "array", "items": { "enum": ["base-url", "model", "credential"] } },
        "provenance": { "type": ["object", "null"] },
        "generated": { "type": "boolean" },
        "activeReferences": { "type": "array", "items": { "enum": ["current", "activated-snapshot"] } }
      },
      "required": ["id", "position", "providerRevision", "name", "baseUrl", "model", "protocol", "authentication", "routingRequirement", "credential", "completeness", "missingFields", "provenance", "generated", "activeReferences"]
    },
    "providerPreset": {
      "type": "object",
      "properties": {
        "key": { "enum": ["openai-api-responses", "anthropic-api-messages"] },
        "baseUrl": { "type": "string" },
        "model": { "const": "" },
        "protocol": { "enum": ["openai-responses", "anthropic-messages"] },
        "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] }
      },
      "required": ["key", "baseUrl", "model", "protocol", "authentication"]
    },
    "controlProblem": {
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "source": { "enum": ["control-plane-context", "user-settings", "managed-settings", "shared-project-settings", "local-project-settings", "codex-profile", "claude-managed", "claude-shared", "claude-project", "claude-local", "claude-selector", "claude-host-managed"] },
        "selector": { "$ref": "#/$defs/claudeBlockingSelector" }
      },
      "required": ["code", "message"]
    },
    "activatedSnapshot": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "providerId": { "type": "string", "format": "uuid" },
        "model": { "type": "string" },
        "protocol": { "enum": ["openai-responses", "anthropic-messages"] },
        "authentication": { "enum": ["openai-bearer", "anthropic-api-key", "anthropic-bearer"] },
        "epoch": { "type": "string", "format": "uuid" }
      },
      "required": ["id", "providerId", "model", "protocol", "authentication", "epoch"],
      "additionalProperties": false
    }
  }
}
