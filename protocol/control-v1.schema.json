{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://muxvia.dev/protocol/control-v1.schema.json",
  "title": "Muxvia control protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/clientFrame" },
    { "$ref": "#/$defs/serverFrame" },
    { "$ref": "#/$defs/targetView" },
    { "$ref": "#/$defs/targetAction" }
  ],
  "$defs": {
    "rpc": {
      "type": "object",
      "properties": { "major": { "const": 1 }, "minor": { "const": 0 } },
      "required": ["major", "minor"]
    },
    "clientFrame": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "hello" }, "rpc": { "$ref": "#/$defs/rpc" }, "release": { "type": "string" } }, "required": ["type", "rpc", "release"] },
        { "type": "object", "properties": { "type": { "const": "request" }, "requestId": { "type": "string" }, "operation": { "$ref": "#/$defs/controlOperation" } }, "required": ["type", "requestId", "operation"] },
        { "type": "object", "properties": { "type": { "const": "cancel" }, "requestId": { "type": "string" } }, "required": ["type", "requestId"] }
      ]
    },
    "serverFrame": {
      "oneOf": [
        { "type": "object", "properties": { "type": { "const": "hello-ack" }, "rpc": { "$ref": "#/$defs/rpc" }, "release": { "type": "string" }, "serviceEpoch": { "type": "string", "format": "uuid" }, "frameLimit": { "const": 1048576 } }, "required": ["type", "rpc", "release", "serviceEpoch", "frameLimit"] },
        { "type": "object", "properties": { "type": { "const": "response" }, "requestId": { "type": "string" }, "result": { "$ref": "#/$defs/controlResult" } }, "required": ["type", "requestId", "result"] },
        { "type": "object", "properties": { "type": { "const": "error" }, "requestId": { "type": ["string", "null"] }, "problem": { "$ref": "#/$defs/controlProblem" }, "authoritativeView": { "$ref": "#/$defs/targetView" } }, "required": ["type", "requestId", "problem"] },
        { "type": "object", "properties": { "type": { "const": "target-view" }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["type", "view"] }
      ]
    },
    "controlOperation": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "open-target" }, "target": { "const": "codex" } }, "required": ["kind", "target"] },
        { "type": "object", "properties": { "kind": { "const": "act" }, "target": { "const": "codex" }, "actionId": { "type": "string", "format": "uuid" }, "expectedRevision": { "type": "integer", "minimum": 0 }, "action": {} }, "required": ["kind", "target", "actionId", "expectedRevision", "action"] },
        { "type": "object", "properties": { "kind": { "const": "discover-models" }, "target": { "const": "codex" }, "source": { "$ref": "#/$defs/discoverySource" } }, "required": ["kind", "target", "source"] },
        { "type": "object", "properties": { "kind": { "const": "check-reachability" }, "target": { "const": "codex" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "target", "providerId", "providerRevision"] }
      ]
    },
    "discoverySource": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "saved" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] },
        { "type": "object", "properties": { "kind": { "const": "draft" }, "baseUrl": { "type": "string" }, "credentialSource": { "$ref": "#/$defs/draftCredentialSource" } }, "required": ["kind", "baseUrl", "credentialSource"] }
      ]
    },
    "draftCredentialSource": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "missing" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "ephemeral" }, "value": { "type": "string" } }, "required": ["kind", "value"] },
        { "type": "object", "properties": { "kind": { "const": "saved" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] }
      ]
    },
    "controlResult": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "target-view" }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["kind", "view"] },
        { "type": "object", "properties": { "kind": { "const": "action-outcome" }, "outcome": { "type": "object", "properties": { "status": { "enum": ["applied", "replayed"] }, "view": { "$ref": "#/$defs/targetView" } }, "required": ["status", "view"] } }, "required": ["kind", "outcome"] },
        { "type": "object", "properties": { "kind": { "const": "model-discovery" }, "result": { "$ref": "#/$defs/modelDiscoveryResult" } }, "required": ["kind", "result"] },
        { "type": "object", "properties": { "kind": { "const": "reachability" }, "result": { "$ref": "#/$defs/reachabilityResult" } }, "required": ["kind", "result"] }
      ]
    },
    "inspectionCategory": {
      "enum": ["invalid-endpoint", "missing-credential", "missing-provider", "stale-provider-revision", "authentication-rejected", "endpoint-unsupported", "rate-limited", "upstream-status", "timeout", "dns", "connect", "tls", "cancelled", "malformed-response", "response-too-large", "too-many-models"]
    },
    "inspectionFailure": {
      "type": "object",
      "properties": { "category": { "$ref": "#/$defs/inspectionCategory" }, "httpStatus": { "type": ["integer", "null"] }, "attempts": { "type": "integer", "minimum": 0 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "endpointOrigin": { "type": ["string", "null"] } },
      "required": ["category", "httpStatus", "attempts", "elapsedMs", "endpointOrigin"]
    },
    "modelDiscoveryResult": {
      "oneOf": [
        { "type": "object", "properties": { "status": { "const": "success" }, "models": { "type": "array", "maxItems": 2048, "items": { "type": "object", "properties": { "id": { "type": "string" }, "displayName": { "type": ["string", "null"] } }, "required": ["id", "displayName"] } }, "attempts": { "type": "integer", "minimum": 1 }, "elapsedMs": { "type": "integer", "minimum": 0 }, "endpointOrigin": { "type": "string" } }, "required": ["status", "models", "attempts", "elapsedMs", "endpointOrigin"] },
        { "type": "object", "properties": { "status": { "const": "failure" }, "failure": { "$ref": "#/$defs/inspectionFailure" } }, "required": ["status", "failure"] }
      ]
    },
    "reachabilityResult": {
      "oneOf": [
        { "type": "object", "properties": { "status": { "const": "reachable" }, "httpStatus": { "type": "integer", "minimum": 100, "maximum": 999 }, "ttfbMs": { "type": "integer", "minimum": 0 }, "checkedAtUnixMs": { "type": "integer", "minimum": 0 }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 }, "slow": { "type": "boolean" }, "endpointOrigin": { "type": "string" } }, "required": ["status", "httpStatus", "ttfbMs", "checkedAtUnixMs", "retryCount", "slow", "endpointOrigin"] },
        { "type": "object", "properties": { "status": { "const": "unreachable" }, "failure": { "$ref": "#/$defs/inspectionFailure" }, "checkedAtUnixMs": { "type": "integer", "minimum": 0 }, "retryCount": { "type": "integer", "minimum": 0, "maximum": 1 } }, "required": ["status", "failure", "checkedAtUnixMs", "retryCount"] }
      ]
    },
    "targetAction": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "create-provider" }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" }, "presetKey": { "oneOf": [{ "const": "openai-api-responses" }, { "type": "null" }] } }, "required": ["kind", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "update-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/credentialEdit" } }, "required": ["kind", "providerId", "providerRevision", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "reorder-providers" }, "providerIds": { "type": "array", "items": { "type": "string", "format": "uuid" } } }, "required": ["kind", "providerIds"] },
        { "type": "object", "properties": { "kind": { "const": "delete-provider" }, "providerId": { "type": "string", "format": "uuid" }, "providerRevision": { "type": "integer", "minimum": 1 } }, "required": ["kind", "providerId", "providerRevision"] },
        { "type": "object", "properties": { "kind": { "const": "duplicate-provider" }, "sourceProviderId": { "type": "string", "format": "uuid" }, "sourceProviderRevision": { "type": "integer", "minimum": 1 }, "name": { "type": "string" }, "baseUrl": { "type": "string" }, "model": { "type": "string" }, "credential": { "$ref": "#/$defs/duplicateCredential" } }, "required": ["kind", "sourceProviderId", "sourceProviderRevision", "name", "baseUrl", "model", "credential"] },
        { "type": "object", "properties": { "kind": { "const": "activate-provider" }, "providerId": { "type": "string" }, "mode": { "enum": ["direct", "takeover"] } }, "required": ["kind", "providerId", "mode"] }
      ]
    },
    "targetView": {
      "type": "object",
      "properties": {
        "target": { "const": "codex" },
        "managementRevision": { "type": "integer", "minimum": 0 },
        "viewSequence": { "type": "integer", "minimum": 0 },
        "service": { "type": "object", "properties": { "epoch": { "type": "string", "format": "uuid" }, "state": { "type": "string" } }, "required": ["epoch", "state"] },
        "mode": { "type": "string" },
        "takeover": { "type": "object" },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
        "providerPresets": { "type": "array", "items": { "$ref": "#/$defs/providerPreset" } },
        "currentProviderId": { "type": ["string", "null"] },
        "servingProviderId": { "type": ["string", "null"] },
        "managedConfiguration": { "type": "object" },
        "recovery": { "type": "object", "properties": { "intentId": { "type": ["string", "null"], "format": "uuid" }, "state": { "type": "string" } }, "required": ["intentId", "state"], "additionalProperties": false },
        "activatedSnapshot": { "oneOf": [{ "$ref": "#/$defs/activatedSnapshot" }, { "type": "null" }] },
        "problems": { "type": "array", "items": { "$ref": "#/$defs/controlProblem" } }
      },
      "required": ["target", "managementRevision", "viewSequence", "service", "mode", "takeover", "providers", "providerPresets", "currentProviderId", "servingProviderId", "managedConfiguration", "recovery", "activatedSnapshot", "problems"]
    },
    "credentialEdit": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "keep" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "remove" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "replace" }, "value": { "type": "string" } }, "required": ["kind", "value"] }
      ]
    },
    "duplicateCredential": {
      "oneOf": [
        { "type": "object", "properties": { "kind": { "const": "without" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "reuse-source" } }, "required": ["kind"] },
        { "type": "object", "properties": { "kind": { "const": "replace" }, "value": { "type": "string" } }, "required": ["kind", "value"] }
      ]
    },
    "provider": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "position": { "type": "integer", "minimum": 0 },
        "providerRevision": { "type": "integer", "minimum": 1 },
        "name": { "type": "string" },
        "baseUrl": { "type": "string" },
        "model": { "type": "string" },
        "protocol": { "const": "openai-responses" },
        "routingRequirement": { "enum": ["direct-compatible", "takeover-required"] },
        "credential": { "enum": ["present", "missing"] },
        "completeness": { "enum": ["complete", "incomplete"] },
        "missingFields": { "type": "array", "items": { "enum": ["base-url", "model", "credential"] } },
        "provenance": { "type": ["object", "null"] },
        "generated": { "type": "boolean" },
        "activeReferences": { "type": "array", "items": { "enum": ["current", "activated-snapshot"] } }
      },
      "required": ["id", "position", "providerRevision", "name", "baseUrl", "model", "protocol", "routingRequirement", "credential", "completeness", "missingFields", "provenance", "generated", "activeReferences"]
    },
    "providerPreset": {
      "type": "object",
      "properties": {
        "key": { "const": "openai-api-responses" },
        "baseUrl": { "const": "https://api.openai.com/v1" },
        "model": { "const": "" },
        "protocol": { "const": "openai-responses" }
      },
      "required": ["key", "baseUrl", "model", "protocol"]
    },
    "controlProblem": {
      "type": "object",
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } },
      "required": ["code", "message"]
    },
    "activatedSnapshot": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "providerId": { "type": "string", "format": "uuid" },
        "model": { "type": "string" },
        "epoch": { "type": "string", "format": "uuid" }
      },
      "required": ["id", "providerId", "model", "epoch"],
      "additionalProperties": false
    }
  }
}
